<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is dark only, whatever the phone's setting, so one dark theme
         serves both modes and nothing flashes white before the first frame. -->

    <!-- Applied while the process starts. A plain color also becomes the
         background of the Android 12+ system splash screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <!-- Applied once the process has started: the window color while Flutter
         initializes and behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>
</resources>
